@startuml C4_Elements
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
!define DEVICONS https://raw.githubusercontent.com/tupadr3/plantuml-icon-font-sprites/master/devicons
!define FONTAWESOME https://raw.githubusercontent.com/tupadr3/plantuml-icon-font-sprites/master/font-awesome-5

AddElementTag("person", $bgColor="BLACK", 
	$fontColor="BLACK", 
	$borderColor="BLACK", 
	$shadowing="big", 
	$shape="circle", 
	$sprite="personSprite", 
	$techn="Person techno", 
	$legendText="This is a legended person", 
	$legendSprite="Person legend sprite", 
	$borderStyle="dotted", 
	$borderThickness="2px")

Person(personAlias, "A person", "This is a person", "Person sprite", "person", "https://microformats.org/wiki/microformats2#person_example", "Person type")
System(systemAlias, "A system", "This is a system", "System sprite", "System tags", "https://docs.structurizr.com/dsl/language#softwaresystem", "System type", "System baseshape (useless when using SystemDb or SystemQueue)")

Rel(personAlias, systemAlias, "A relationship between person and system", "This is person to system technology")
@enduml