@startuml C4_Elements
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

Person(personAlias, "A person", "This is a person")
Enterprise_Boundary(company, "Company boundary") {
	System_Boundary(domainBoundary, "Domain boundary") {
		System(systemAlias, "A system")
	}
}

Rel(personAlias, systemAlias, "A relationship between person and system", "This is person to system technology")
@enduml