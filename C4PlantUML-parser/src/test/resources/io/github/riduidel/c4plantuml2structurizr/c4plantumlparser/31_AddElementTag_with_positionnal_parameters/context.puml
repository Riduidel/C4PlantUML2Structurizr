@startuml C4_Elements
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
!define DEVICONS https://raw.githubusercontent.com/tupadr3/plantuml-icon-font-sprites/master/devicons
!define FONTAWESOME https://raw.githubusercontent.com/tupadr3/plantuml-icon-font-sprites/master/font-awesome-5

AddElementTag("system", "bgColor")
AddElementTag("system", "bgColor", "fontColor")
AddElementTag("system", "bgColor", "fontColor", "borderColor")
AddElementTag("system", "bgColor", "fontColor", "borderColor", "shadowing")
AddElementTag("system", "bgColor", "fontColor", "borderColor", "shadowing", "shape")
AddElementTag("system", "bgColor", "fontColor", "borderColor", "shadowing", "shape", "sprite")
AddElementTag("system", "bgColor", "fontColor", "borderColor", "shadowing", "shape", "sprite", "technology")
AddElementTag("system", "bgColor", "fontColor", "borderColor", "shadowing", "shape", "sprite", "technology", "legendText")
AddElementTag("system", "bgColor", "fontColor", "borderColor", "shadowing", "shape", "sprite", "technology", "legendText", "legendSprite")
AddElementTag("system", "bgColor", "fontColor", "borderColor", "shadowing", "shape", "sprite", "technology", "legendText", "legendSprite", "borderStyle")
AddElementTag("system", "bgColor", "fontColor", "borderColor", "shadowing", "shape", "sprite", "technology", "legendText", "legendSprite", "borderStyle", "borderThickness")


Person(personAlias, "A person", "This is a person", "Person sprite", "person", "https://microformats.org/wiki/microformats2#person_example", "Person type")
System(systemAlias, "A system", "This is a system", "System sprite", "system", "https://docs.structurizr.com/dsl/language#softwaresystem", "System type", "System baseshape (useless when using SystemDb or SystemQueue)")

Rel(personAlias, systemAlias, "A relationship between person and system", "This is person to system technology")
@enduml