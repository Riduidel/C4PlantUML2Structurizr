<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>io.github.riduidel</groupId>
    <artifactId>C4PlantUML2Structurizr</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <modules>
        <module>structurizr-dsl-writer</module>
        <module>structurizr-copier</module>
        <module>C4PlantUML-parser</module>
    </modules>
    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jacoco.version>0.8.12</jacoco.version>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.structurizr</groupId>
                <artifactId>structurizr-core</artifactId>
                <version>6.2.1</version>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>3.27.3</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <build>
        <defaultGoal>verify</defaultGoal>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.9.0</version>
            </plugin>
        </plugins>
    </build>
    <url>https://riduidel.github.io/C4PlantUML2Structurizr/</url>
    <licenses>
        <license>
            <name>The Apache License, Version 2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>Riduidel</id>
            <name>Nicolas Delsaux</name>
            <email>nicolas.delsaux@gmx.fr</email>
            <roles>
                <role>Tech Lead</role>
            </roles>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://git@github.com/Riduidel/C4PlantUML2Structurizr.git</connection>
        <developerConnection>scm:git:https://git@github.com/Riduidel/C4PlantUML2Structurizr.git</developerConnection>
        <url>https://github.com/Riduidel/C4PlantUML2Structurizr.git</url>
    </scm>
    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/Riduidel/C4PlantUML2Structurizr/issues</url>
    </issueManagement>
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/Riduidel/C4PlantUML2Structurizr</url>
        </repository>
    </distributionManagement>
    <profiles>
        <profile>
            <id>Measure code quality with Jacoco</id>
            <activation>
                <file>
                    <exists>src/test/java</exists>
                </file>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <version>${jacoco.version}</version>
                        <configuration>
                            <excludes>
                                <exclude>**/librariesio/model/*</exclude>
                                <exclude>**/ingester/model/*</exclude>
                                <exclude>**/github/model/*</exclude>
                                <exclude>**/stackoverflow/model/*</exclude>
                                <exclude>**/annotations/*</exclude>
                                <exclude>**/enums/*</exclude>
                                <exclude>**/exceptions/*</exclude>
                                <exclude>**/*.docx</exclude>
                                <exclude>**/*.xlsx</exclude>
                                <exclude>**/*.jks</exclude>
                                <exclude>**/*.png</exclude>
                                <exclude>**/*.ttf</exclude>
                                <exclude>**/*.woff</exclude>
                            </excludes>
                        </configuration>
                        <executions>
                            <execution>
                                <id>Jacoco - prepare agent</id>
                                <goals>
                                    <goal>prepare-agent</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>Jacoco - generate report</id>
                                <goals>
                                    <goal>report</goal>
                                </goals>
                                <phase>test</phase>
                            </execution>
                            <execution>
                                <id>Jacoco - is code covered?</id>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                                <phase>verify</phase>
                                <configuration>
                                    <rules>
                                        <rule>
                                            <element>BUNDLE</element>
                                            <limits>
                                                <limit>
                                                    <counter>INSTRUCTION</counter>
                                                    <value>COVEREDRATIO</value>
                                                    <minimum>${jacoco.covered.instructions.target.percentage}</minimum>
                                                </limit>
                                            </limits>
                                        </rule>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>update-target-coverage</id>
            <activation>
                <file>
                    <exists>target/site/jacoco/index.html</exists>
                </file>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.gmaven</groupId>
                        <artifactId>groovy-maven-plugin</artifactId>
                        <dependencies>
                            <dependency>
                                <groupId>org.jsoup</groupId>
                                <artifactId>jsoup</artifactId>
                                <version>1.22.1</version>
                            </dependency>
                        </dependencies>
                        <executions>
                            <execution>
                                <id>update jacoco treshold from test results</id>
                                <goals>
                                    <goal>execute</goal>
                                </goals>
                                <phase>verify</phase>
                                <configuration>
                                    <source>src/build/groovy/updateJacocoTarget.groovy</source>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>Make my code spotless!</id>
            <activation>
                <file>
                    <exists>pom.xml</exists>
                </file>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.diffplug.spotless</groupId>
                        <artifactId>spotless-maven-plugin</artifactId>
                        <version>3.10.2</version>
                        <configuration>
                            <pom>
                                <sortPom>
                                    <encoding>UTF-8</encoding>
                                    <indentAttribute>schemaLocation</indentAttribute>
                                    <predefinedSortOrder>custom_1</predefinedSortOrder>
                                    <sortDependencies>scope,groupId,artifactId</sortDependencies>
                                    <nrOfIndentSpace>4</nrOfIndentSpace>
                                    <keepBlankLines>false</keepBlankLines>
                                </sortPom>
                            </pom>
                        </configuration>
                        <executions>
                            <execution>
                                <id>Perform all formatting operations at once</id>
                                <goals>
                                    <goal>apply</goal>
                                </goals>
                                <phase>process-sources</phase>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
